{
  "extends": "@ledgerly/config/tsconfig.base.json",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024", "dom", "dom.iterable"],
    // Vite bundles the app: imports are extensionless and resolved the bundler way.
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true,
    "paths": { "@admin/*": ["./src/*"] }
  },
  "include": ["src", "*.ts"],
  "exclude": ["node_modules", "dist"]
}
