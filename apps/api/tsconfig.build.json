{
  "extends": "@ledgerly/config/tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "composite": false
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../../packages/domain/tsconfig.build.json" }]
}
