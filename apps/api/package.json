{
  "name": "@ledgerly/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=@ledgerly/source --env-file-if-exists=../../.env --watch --import ./src/instrumentation.ts src/main.ts",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts && git diff --exit-code -- src/graphql/__generated__",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "keys": "node src/scripts/generate-keys.ts"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@graphql-tools/schema": "11.0.7",
    "@ledgerly/domain": "workspace:*",
    "@ledgerly/graphql": "workspace:*",
    "@ledgerly/validation": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation-express": "0.72.0",
    "@opentelemetry/instrumentation-graphql": "0.72.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-mongodb": "0.77.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "cookie-parser": "1.4.7",
    "dataloader": "2.2.3",
    "express": "5.3.0",
    "express-rate-limit": "8.6.1",
    "graphql": "^16.14.2",
    "jose": "6.2.13",
    "mongoose": "9.11.4",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@ledgerly/config": "workspace:*",
    "@testcontainers/mongodb": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
