{
  "name": "ledgerly",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^24.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "check": "pnpm format:check && turbo run lint typecheck test:coverage && pnpm depcruise"
  },
  "devDependencies": {
    "@ledgerly/config": "workspace:*",
    "dependency-cruiser": "18.7.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "~6.0.3"
  },
  "//": {
    "typescript": "Pinned ~6.0: typescript-eslint@8 declares typescript >=4.8.4 <6.1.0. typescript@latest is 7.x. See CLAUDE.md."
  }
}
