{
  "name": "@ledgerly/validation",
  "version": "0.0.0",
  "private": true,
  "description": "zod input schemas shared by forms (web, admin) and resolvers (api).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@ledgerly/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ledgerly/domain": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ledgerly/config": "workspace:*",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "typescript": "~6.0.3",
    "vitest": "5.0.5"
  }
}
